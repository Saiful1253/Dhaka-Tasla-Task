# See repo root .env.example - backend reads the same variables.
# On Vercel, use the managed PostgreSQL URL; Docker is not required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dhaka_tesla_pool?schema=public
JWT_SECRET=change-me-generate-a-real-secret
PORT=4000
BASE_FARE_TAKA=50
RATE_PER_KM_TAKA=15
POOL_DISCOUNT_PCT=20
