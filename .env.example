# ---- API ----
PORT=4000
NODE_ENV=development

# ---- Database (used by Prisma) ----
# Local (outside Docker): postgresql://postgres:postgres@localhost:5432/dhaka_tesla_pool?schema=public
# Inside Docker Compose the API uses the DATABASE_URL set in docker-compose.yml (host: db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dhaka_tesla_pool?schema=public

# ---- Auth ----
# NEVER commit a real secret. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-real-secret

# ---- Fare model (whole Taka) ----
BASE_FARE_TAKA=50
RATE_PER_KM_TAKA=15
POOL_DISCOUNT_PCT=20
